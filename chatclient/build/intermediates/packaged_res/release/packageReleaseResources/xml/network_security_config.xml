<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN deployment: the ET server speaks plain HTTP on http://IP:8080. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
