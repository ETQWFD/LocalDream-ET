set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(TOOLCHAIN $ENV{HOME}/tools/llvm-mingw-20260922-ucrt-ubuntu-22.04-x86_64)
set(CMAKE_C_COMPILER   ${TOOLCHAIN}/bin/x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN}/bin/x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER  ${TOOLCHAIN}/bin/x86_64-w64-mingw32-windres)
set(CMAKE_FIND_ROOT_PATH ${TOOLCHAIN}/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_FLAGS_INIT "-pthread")
set(CMAKE_CXX_FLAGS_INIT "-pthread")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-pthread")
