<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- et.21: downloaded update APKs land in the shared public folder
         /storage/emulated/0/LocalDreamET/temp_downloads so they survive cache
         clears and the system package installer can read them directly. -->
    <external-storage-path
        name="public_updates"
        path="LocalDreamET/temp_downloads/" />
    <!-- et.24: exported diagnostic reports live at LocalDreamET/diagnostics_*.txt. -->
    <external-path
        name="public_diagnostics"
        path="LocalDreamET/" />
    <!-- Internal-storage fallback when All-files-access is not granted:
         filesDir/LocalDreamET/temp_downloads (covered by files_root). -->
    <files-path
        name="files_root"
        path="." />
    <!-- Legacy cache locations kept for any in-flight older download. -->
    <cache-path
        name="update_apks"
        path="updates/" />
    <cache-path
        name="cache_root"
        path="." />
    <external-cache-path
        name="external_update_apks"
        path="updates/" />
</paths>
